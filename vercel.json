{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/serverless/**"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "heal/*": true
    }
  },
  "github": {
    "silent": true
  }
}
