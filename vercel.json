{
  
  "installCommand": "pnpm install --no-frozen-lockfile",
  
  "buildCommand": "pnpm run build",
  
  "outputDirectory": "dist/public",
  
  "rewrites": [
    
    {
      
      "source": "/api/:path*",
      
      "destination": "/api/[...path]"
      
    }
    
  ],
  
  "git": {
    
    "deploymentEnabled": {
      
      "main": true,
      
      "heal/*": true
      
    }
    
  },
  
  "github": {
    
    "silent": true
    
  }
  
}




















